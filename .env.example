# Kopier til .env og tilpass. .env skal aldri committes.

# Backend
PORT=3001
DATABASE_URL=postgres://postgres@localhost:5432/project2
# Egen database for tester – tømmes av testene.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/project2_test
# Tillatt opprinnelse for CORS i utvikling (Vite dev-server).
CORS_ORIGIN=http://localhost:5173

# Import: mappe med title.basics.tsv.gz og title.ratings.tsv.gz
IMDB_DATA_DIR=./data
# Minste antall stemmer for at en tittel tas med
IMDB_MIN_VOTES=100

# Frontend (valgfri – standard er <base>/graphql)
VITE_GRAPHQL_URL=
