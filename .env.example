# Kopier til .env og tilpass. .env skal aldri committes.
# `npm run setup` gjør kopieringen for deg (og overskriver aldri en eksisterende .env).
#
# Bruker eller passord annerledes enn under? Sett dem i DATABASE_URL og TEST_DATABASE_URL, f.eks.
#   postgres://it2810:hemmelig@localhost:5432/project2

# Backend
PORT=3001
DATABASE_URL=postgres://postgres@localhost:5432/project2
# Egen database for tester – tømmes av testene.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/project2_test
# Tillatt opprinnelse for CORS i utvikling (Vite dev-server).
CORS_ORIGIN=http://localhost:5173

# Import: mappe med title.basics.tsv.gz og title.ratings.tsv.gz
IMDB_DATA_DIR=./data
# Minste antall stemmer for at en tittel tas med
IMDB_MIN_VOTES=100

# Frontend (valgfri – standard er <base>/graphql)
VITE_GRAPHQL_URL=

# Bilder og handling fra TMDB (https://www.themoviedb.org/settings/api).
# La stå tom i utvikling: `npm run dev` starter da en falsk TMDB-server (port 3999) og en falsk
# Internet Archive (port 3998) og setter URL-ene under selv, så plakater og gratisfilmer vises uten
# nøkler. Med ekte nøkkel brukes ekte TMDB. (Backend alene, uten `npm run dev`, viser plassholdere.)
TMDB_API_KEY=
# Settes automatisk av `npm run dev` når nøkkelen er tom. Manuelt (npm run tmdb:mock -w backend):
# TMDB_API_URL=http://localhost:3999/3
# TMDB_IMAGE_URL=http://localhost:3999/t/p

# Lovlige gratisfilmer fra Internet Archive (npm run db:archive). Standard er den ekte tjenesten.
# `npm run dev` bruker den falske serveren (port 3998) når TMDB_API_KEY er tom og denne er utkommentert.
# Manuelt (npm run archive:mock -w backend):
# ARCHIVE_URL=http://localhost:3998

# Antall syntetiske titler som `npm run setup` genererer hvis data/ er tom (standard 20000).
# 120000 gir det store settet, men tar lengre tid.
# FIXTURE_SIZE=20000
