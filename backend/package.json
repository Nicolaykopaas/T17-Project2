{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/import-imdb.ts",
    "db:fixture": "tsx scripts/generate-fixture.ts",
    "db:artwork": "tsx scripts/prefetch-artwork.ts",
    "db:measure": "tsx scripts/measure-performance.ts",
    "db:archive": "tsx scripts/import-archive.ts",
    "tmdb:mock": "tsx scripts/tmdb-mock.ts",
    "archive:mock": "tsx scripts/archive-mock.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.1",
    "pg": "^8.23.0"
  }
}
